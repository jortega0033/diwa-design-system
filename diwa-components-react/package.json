{
  "name": "@diwa-design-system/components-react",
  "version": "3.1.3",
  "description": "React wrapper package for Diwa Web Components.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/patch-generated-react-lib.cjs && tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@diwa-design-system/components": "^3.1.3",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@diwa-design-system/components": "file:../diwa-components",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/jortega0033/diwa-design-system"
}
